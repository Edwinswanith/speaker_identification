# Map each calling project's tenant/workspace ID to its private API token.
# Replace both examples with strong, randomly generated secrets.
API_KEYS_JSON={"mediscript":"replace-with-at-least-32-random-characters","another-project":"replace-with-a-different-secret"}

# Vercel is the caller, not the model host. After deploying this container,
# set these in the CALLING Vercel project's Settings > Environment Variables.
# The token there must equal the value for that Vercel tenant in API_KEYS_JSON.
# SPEAKER_MATCH_API_URL=https://your-deployed-voice-api.example
# SPEAKER_MATCH_API_TOKEN=<the matching private token from API_KEYS_JSON>

# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
EMBEDDING_ENCRYPTION_KEY=replace-with-a-fernet-key

# For local use, SQLite is fine. Production can use PostgreSQL via DATABASE_URL.
DATABASE_URL=sqlite:///./data/speakers.db
MODEL_CACHE_DIR=./models/speechbrain-ecapa
MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
MODEL_REVISION=eac2726
DEVICE=cpu

# Bounded in-process inference: 2 CPU workers is a starting point, not a throughput guarantee.
MAX_CONCURRENT_INFERENCES=2
MAX_QUEUED_INFERENCES=8
QUEUE_WAIT_SECONDS=120
TORCH_NUM_THREADS=1

MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=180
MIN_USABLE_SPEECH_SECONDS=3
RECOMMENDED_ENROLLMENT_SECONDS=20
MATCH_THRESHOLD=0.72
MATCH_MARGIN=0.08
TOP_CANDIDATES=5
